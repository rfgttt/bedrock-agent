# DeepSeek official OpenAI-compatible API.
# Create a key in the DeepSeek platform, then copy this file to .env.
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-v4-flash

# Private data. Do not put this directory in Git or cloud sync.
AGENT_DATA_DIR=./private
AGENT_DB_PATH=./private/bedrock.db
AGENT_WORKSPACE=./workspace
AGENT_TRACE_DIR=./private/traces
AGENT_TOKEN_FILE=./private/local_api.token

# Local-only API. Non-loopback values are rejected by code.
AGENT_BIND_HOST=127.0.0.1
AGENT_BIND_PORT=8765

# Bedrock refuses to start under a different OS account.
# Set this to your Windows/Linux login name.
AGENT_OWNER_USER=

AGENT_MAX_STEPS=8
AGENT_MEMORY_CONTEXT_LIMIT=5

# Performance and growth limits. Defaults are conservative for a desktop app.
AGENT_MODEL_MESSAGE_LIMIT=80
AGENT_DESKTOP_MESSAGE_LIMIT=300
AGENT_MODEL_TIMEOUT_SECONDS=60
AGENT_MODEL_MAX_RETRIES=1
AGENT_TRACE_FILE_LIMIT=500
AGENT_EPISODE_MEMORY_LIMIT=1000
